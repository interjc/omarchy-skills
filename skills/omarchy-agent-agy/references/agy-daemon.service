[Unit]
Description=Optional Antigravity stream-json session (experimental quota support)
PartOf=default.target

[Service]
Type=simple
# Template: setup.sh substitutes the resolved executable for @AGY_BIN@.
# No permission-bypass flags. Verify CLI support and quota discovery locally.
ExecStart=/usr/bin/bash "%h/.local/lib/omarchy-agent-agy/agy-daemon.sh" "@AGY_BIN@"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=HOME=%h

[Install]
WantedBy=default.target
